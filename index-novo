const levels = [
    { max: 25, label: "Preparação Inicial", desc: "A sua empresa está a dar os primeiros passos. É crucial construir alicerces de proteção de dados e alfabetização em IA." },
    { max: 50, label: "Preparação Emergente", desc: "Já existem iniciativas, mas carecem de alinhamento e regras. É o momento de coordenar esforços e definir responsabilidades." },
    { max: 75, label: "Preparação em Desenvolvimento", desc: "A IA já faz parte das operações, com regras estabelecidas. O foco deve ser a expansão segura e o redesenho de processos." },
    { max: 100, label: "Preparação Consolidada", desc: "Existe uma abordagem estratégica e estruturada. O objetivo é manter o acompanhamento rigoroso e a medição do valor gerado." }
];

/* ==========================================
   STATE MANAGEMENT
   ========================================== */
let appState = {
    participantId: null,
    currentScreen: 'home', // 'home', 'moment', 'message', 'results'
    currentQuestionIndex: 0,
    answers: {} // { qId: optionIndex }
};

// Load state from local storage
function loadState() {
    let saved = null;
    try { saved = localStorage.getItem('skolae_ia_diagnostic'); } catch (e) {}
    try {
        if (saved) {
            appState = { ...appState, ...JSON.parse(saved) };
        }
    } catch (e) {}
    if (!appState.participantId) {
        appState.participantId = 'USR-' + Math.random().toString(36).substr(2, 9).toUpperCase();
    }
}

function saveState() {
    try {
        localStorage.setItem('skolae_ia_diagnostic', JSON.stringify({
            participantId: appState.participantId,
            currentScreen: appState.currentScreen,
            currentQuestionIndex: appState.currentQuestionIndex,
            answers: appState.answers
        }));
    } catch (e) { /* armazenamento indisponível: a app continua a funcionar em memória */ }
}

/* ==========================================
   CORE LOGIC & ROUTING
   ========================================== */
function init() {
    loadState();
    render();
}

function resetApp() {
    try { localStorage.removeItem('skolae_ia_diagnostic'); } catch (e) {}
    appState = {
        participantId: 'USR-' + Math.random().toString(36).substr(2, 9).toUpperCase(),
        currentScreen: 'home',
        currentQuestionIndex: 0,
        answers: {}
    };
    window.scrollTo(0, 0);
    render();
}

function startDiagnostic() {
    appState.currentScreen = 'moment';
    
    // Find the right question to start/resume
    let targetIndex = 0;
    for (let i = 0; i < questions.length; i++) {
        if (appState.answers[questions[i].id] === undefined) {
            targetIndex = i;
            break;
        }
        if (i === questions.length - 1) {
            // All answered
            appState.currentScreen = 'results';
        }
    }
    
    appState.currentQuestionIndex = appState.currentScreen === 'moment' ? targetIndex : appState.currentQuestionIndex;
    saveState();
    window.scrollTo(0, 0); // Volta ao topo ao mudar de ecrã
    render();
}

function submitAnswer(qId, optionIndex) {
    appState.answers[qId] = optionIndex;
    appState.currentScreen = 'message';
    saveState();
    window.scrollTo(0, 0);
    render();
}

function nextAction() {
    const nextQIndex = appState.currentQuestionIndex + 1;
    
    if (nextQIndex < questions.length) {
        appState.currentQuestionIndex = nextQIndex;
        appState.currentScreen = 'moment';
    } else {
        // Finished all questions
        appState.currentScreen = 'results';
    }
    
    saveState();
    window.scrollTo(0, 0);
    render();
}

/* ==========================================
   SCORING LOGIC
   ========================================== */
function calculateResults() {
    let obtainedPoints = 0;
    let maxPoints = 0;
    let answeredCount = 0;
    let categoryScores = [];

    questions.forEach(q => {
        const ansIndex = appState.answers[q.id];
        if (ansIndex !== undefined) {
            answeredCount++;
            const points = q.options[ansIndex].score;
            obtainedPoints += points;
            // Q7 has max 4 points, others max 3
            const qMax = Math.max(...q.options.map(o => o.score));
            maxPoints += qMax;
            
            categoryScores.push({
                id: q.id,
                title: q.title,
                points: points,
                max: qMax,
                percentage: (points / qMax) * 100,
                recommendation: q.recommendation
            });
        }
    });

    const isComplete = answeredCount >= 7; // Minimum threshold
    const finalScore = isComplete ? Math.round((obtainedPoints / maxPoints) * 100) : null;
    
    let classification = null;
    if (isComplete) {
        classification = levels.find(l => finalScore <= l.max);
    }

    // Sort to find strengths and weaknesses
    categoryScores.sort((a, b) => b.percentage - a.percentage);
    const strengths = categoryScores.slice(0, 3);
    const weaknesses = [...categoryScores].sort((a, b) => a.percentage - b.percentage).slice(0, 3);

    return { isComplete, finalScore, classification, strengths, weaknesses, answeredCount };
}

/* ==========================================
   RENDERERS
   ========================================== */
function render() {
    const container = document.getElementById('app-container');
    container.innerHTML = ''; // Clear

    switch (appState.currentScreen) {
        case 'home': container.innerHTML = getHomeHTML(); break;
        case 'moment': container.innerHTML = getQuestionHTML(); setupQuestionListeners(); break;
        case 'message': container.innerHTML = getMessageHTML(); break;
        case 'results': container.innerHTML = getResultsHTML(); break;
    }
}

function getHomeHTML() {
    // Removido "my-auto" para não bloquear o scroll no telemóvel
    return `
        <div class="fade-in bg-skolae-dark rounded-2xl p-6 md:p-8 border border-gray-800 shadow-2xl text-center mt-4">
            <h1 class="text-2xl md:text-3xl font-bold mb-4 leading-tight">A SUA EMPRESA ESTÁ <span class="text-skolae-orange">PREPARADA PARA A IA?</span></h1>
            <p class="text-gray-300 text-sm md:text-base mb-6 leading-relaxed font-light">
                "Descubra como a sua organização está a transformar o potencial da inteligência artificial em valor."
            </p>
            <div class="bg-black/50 rounded-xl p-5 mb-8 text-left border border-gray-800">
                <p class="text-sm text-gray-300 mb-3"><i class="fas fa-info-circle text-skolae-orange mr-2"></i> Ao longo desta experiência, vai descobrir como a sua empresa está preparada para utilizar inteligência artificial, proteger a informação, desenvolver competências e criar valor.</p>
                <ul class="text-sm text-gray-400 space-y-2 mt-4 ml-1">
                    <li><i class="fas fa-list-ol mr-2 opacity-70"></i> 11 perguntas em 6 etapas</li>
                    <li><i class="far fa-clock mr-2 opacity-70"></i> 4 a 6 minutos no total</li>
                    <li><i class="fas fa-user-secret mr-2 opacity-70"></i> Participação 100% anónima</li>
                </ul>
            </div>
            <button onclick="startDiagnostic()" class="w-full bg-skolae-orange hover:bg-skolae-hover text-black font-semibold text-lg py-4 rounded-xl transition-all shadow-[0_0_15px_rgba(255,156,37,0.3)] hover:shadow-[0_0_25px_rgba(255,156,37,0.5)] transform hover:-translate-y-0.5">
                Iniciar Diagnóstico
            </button>
            <p class="text-xs text-gray-500 mt-5 italic">
                Nota: As respostas representam a sua perceção e não constituem uma auditoria empresarial.
            </p>
        </div>
    `;
}

function getQuestionHTML() {
    const q = questions[appState.currentQuestionIndex];
    const totalQ = questions.length;
    const currentNum = appState.currentQuestionIndex + 1;
    const progress = ((currentNum - 1) / totalQ) * 100;
    
    const prevAnswer = appState.answers[q.id];

    let optionsHTML = q.options.map((opt, idx) => `
        <label class="block cursor-pointer relative slide-up" style="animation-delay: ${idx * 0.1}s">
            <input type="radio" name="q${q.id}" value="${idx}" class="peer sr-only option-radio" ${prevAnswer === idx ? 'checked' : ''}>
            <div class="p-4 rounded-xl border border-gray-700 bg-black/40 hover:bg-gray-800 transition-all flex items-start gap-4">
                <div class="mt-0.5 w-5 h-5 rounded-full border-2 border-gray-500 flex-shrink-0 radio-circle transition-colors flex items-center justify-center">
                    <div class="w-2.5 h-2.5 rounded-full bg-black scale-0 transition-transform peer-checked:scale-100"></div>
                </div>
                <span class="text-sm md:text-base text-gray-200 font-medium">${opt.text}</span>
            </div>
        </label>
    `).join('');

    return `
        <div class="fade-in flex flex-col pt-4">
            <div class="mb-6 flex justify-between items-end">
                <div>
                    <span class="text-skolae-orange text-xs font-bold tracking-widest uppercase mb-1 block">Momento ${q.moment}</span>
                    <h3 class="text-gray-400 text-sm">Pergunta ${currentNum} de ${totalQ}</h3>
                </div>
            </div>
            
            <div class="w-full bg-gray-800 rounded-full h-1.5 mb-8">
                <div class="bg-skolae-orange h-1.5 rounded-full transition-all duration-500" style="width: ${progress}%"></div>
            </div>

            <div class="bg-skolae-dark border border-gray-800 rounded-2xl p-6 md:p-8 shadow-xl mb-6">
                <h2 class="text-xl md:text-2xl font-semibold mb-2">${q.title}</h2>
                <p class="text-gray-300 mb-6 text-sm md:text-base">${q.text}</p>
                
                <div class="space-y-3" id="options-container">
                    ${optionsHTML}
                </div>
            </div>

            <button id="btn-confirm" class="w-full bg-skolae-orange hover:bg-skolae-hover text-black font-semibold text-lg py-4 rounded-xl transition-all shadow-lg mt-4 disabled:opacity-50 disabled:cursor-not-allowed" ${prevAnswer === undefined ? 'disabled' : ''}>
                Confirmar Resposta
            </button>
        </div>
    `;
}

function setupQuestionListeners() {
    const radios = document.querySelectorAll('.option-radio');
    const btn = document.getElementById('btn-confirm');
    
    radios.forEach(radio => {
        radio.addEventListener('change', () => {
            btn.disabled = false;
        });
    });

    btn.addEventListener('click', () => {
        const selected = document.querySelector('.option-radio:checked');
        if (selected) {
            const qId = questions[appState.currentQuestionIndex].id;
            submitAnswer(qId, parseInt(selected.value));
        }
    });
}

function getMessageHTML() {
    const q = questions[appState.currentQuestionIndex];
    return `
        <div class="fade-in bg-skolae-dark border-l-4 border-skolae-orange rounded-r-2xl p-8 shadow-2xl flex flex-col justify-center items-center text-center mt-8">
            <div class="w-16 h-16 rounded-full bg-skolae-orange/10 flex items-center justify-center mb-6">
                <i class="fas fa-lightbulb text-3xl text-skolae-orange"></i>
            </div>
            <p class="text-lg md:text-xl font-medium text-gray-200 leading-relaxed mb-10 italic">
                "${q.message}"
            </p>
            <button onclick="nextAction()" class="w-full bg-white hover:bg-gray-200 text-black font-semibold text-base py-4 rounded-xl transition-colors">
                Continuar <i class="fas fa-arrow-right ml-2"></i>
            </button>
        </div>
    `;
}

function getResultsHTML() {
    const res = calculateResults();
    
    if (!res.isComplete) {
        return `
            <div class="fade-in bg-skolae-dark rounded-2xl p-8 border border-gray-800 text-center mt-8">
                <i class="fas fa-exclamation-triangle text-4xl text-yellow-500 mb-4"></i>
                <h2 class="text-xl font-bold mb-2">Diagnóstico Incompleto</h2>
                <p class="text-gray-400 mb-6">Respondeu a ${res.answeredCount} de ${questions.length} perguntas. São necessárias pelo menos 7 respostas para calcular um perfil fidedigno.</p>
                <button onclick="appState.currentScreen='home'; render();" class="w-full bg-white hover:bg-gray-200 text-black font-semibold text-base py-4 rounded-xl transition-colors">
                    Voltar ao Início
                </button>
            </div>
        `;
    }

    const weaknessesHTML = res.weaknesses.map(w => `
        <div class="mb-4 bg-black/30 p-4 rounded-lg border-l-2 border-skolae-orange print-bg-white">
            <h4 class="font-bold text-white text-sm mb-1 print-text-black"><i class="fas fa-exclamation-circle text-skolae-orange mr-2"></i> ${w.title}</h4>
            <p class="text-sm text-gray-400 mb-2 print-text-black">Prioridade de melhoria identificada.</p>
            <p class="text-sm text-skolae-orange bg-skolae-orange/10 p-2 rounded inline-block w-full">
                <i class="fas fa-arrow-right mr-1 text-xs"></i> <strong>Recomendação:</strong> ${w.recommendation}
            </p>
        </div>
    `).join('');

    return `
        <div id="pdf-content" class="fade-in bg-skolae-dark rounded-2xl p-6 md:p-8 border border-gray-800 shadow-2xl mb-8 mt-4 print-bg-white">
            <div class="text-center mb-8">
                <h2 class="text-skolae-orange font-bold text-xs tracking-widest uppercase mb-2">O Diagnóstico da sua Empresa</h2>
                <div class="flex justify-center items-center my-6">
                    <div class="relative w-32 h-32 flex items-center justify-center rounded-full bg-black border-4 border-gray-800 print-bg-white">
                        <svg class="absolute inset-0 w-full h-full transform -rotate-90">
                            <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="8" class="text-gray-800"></circle>
                            <circle cx="60" cy="60" r="56" fill="none" stroke="#FF9C25" stroke-width="8" stroke-dasharray="351" stroke-dashoffset="${351 - (351 * res.finalScore) / 100}" class="transition-all duration-1000 ease-out"></circle>
                        </svg>
                        <span class="text-3xl font-bold print-text-black">${res.finalScore}<span class="text-sm text-gray-500">%</span></span>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2 print-text-black">${res.classification.label}</h3>
                <p class="text-sm text-gray-400 max-w-sm mx-auto print-text-black">${res.classification.desc}</p>
            </div>

            <hr class="border-gray-800 my-6">

            <div class="mb-8">
                <h4 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-4 flex items-center print-text-black">
                    <i class="fas fa-tools mr-2 text-skolae-orange"></i> Prioridades de Ação Recomendadas
                </h4>
                <div class="text-left">
                    ${weaknessesHTML}
                </div>
            </div>

            <div class="bg-gray-900/50 p-4 rounded-xl border border-gray-800 text-xs text-gray-500 text-center print-bg-white print-text-black">
                Os resultados apresentados resultam de um autodiagnóstico indicativo e não substituem uma auditoria formal ou aconselhamento especializado. ID da Sessão: ${appState.participantId}
            </div>
        </div>

        <button onclick="downloadPDF()" class="w-full bg-white hover:bg-gray-200 text-black font-bold text-lg py-4 rounded-xl transition-all shadow-lg flex justify-center items-center mb-3 no-print">
            <i class="fas fa-file-pdf mr-2"></i> Guardar o meu Diagnóstico
        </button>
        <button id="btn-copy" onclick="copyResults()" class="w-full bg-skolae-dark border border-gray-700 hover:bg-gray-800 text-white font-semibold text-base py-3 rounded-xl transition-colors flex justify-center items-center mb-3 no-print">
            <i class="far fa-copy mr-2"></i> Copiar resumo
        </button>
        <button onclick="resetApp()" class="w-full text-gray-400 hover:text-white text-sm py-3 mb-6 no-print">
            <i class="fas fa-rotate-left mr-2"></i> Refazer o diagnóstico
        </button>
    `;
}

function downloadPDF() {
    try { window.print(); } catch (e) { copyResults(); }
}

function copyResults() {
    const res = calculateResults();
    if (!res.isComplete) return;
    const lines = [
        'Diagnóstico IA – Skolae Experience Day 2026',
        'Nível: ' + res.classification.label + ' (' + res.finalScore + '%)',
        res.classification.desc,
        '',
        'Prioridades de ação recomendadas:',
        ...res.weaknesses.map((w, i) => (i + 1) + '. ' + w.title + ' – ' + w.recommendation)
    ].join('\n');
    const btn = document.getElementById('btn-copy');
    const done = ok => { if (btn) btn.innerHTML = ok ? '<i class="fas fa-check mr-2"></i> Copiado' : 'Não foi possível copiar'; };
    try {
        navigator.clipboard.writeText(lines).then(() => done(true), () => done(false));
    } catch (e) { done(false); }
}

// Start app
try { init(); } catch (e) {
    document.getElementById('app-container').innerHTML =
        '<div class="bg-skolae-dark rounded-2xl p-6 mt-8 text-center border border-gray-800"><p class="mb-4">Ocorreu um erro ao carregar o diagnóstico.</p><button onclick="try{localStorage.clear()}catch(e){};location.reload()" class="w-full bg-skolae-orange text-black font-semibold py-3 rounded-xl">Recarregar</button></div>';
}
</script>
</body>
</html>
